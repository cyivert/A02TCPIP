<Window x:Class="WordGameClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WordGameClient"
        mc:Ignorable="d"
        Title="Word Game Client" Height="893" Width="1115"
        Closing="Window_Closing">
    <DockPanel>
        <!-- Navigation Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Game" Command="{Binding StartGameCommand}"/>
                <MenuItem Header="_Play Again" Command="{Binding PlayAgainYesCommand}"/>
                <Separator/>
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Connection" Click="ConnectionMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Header="_About Word Game" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ServerEndpointLabel}"/>
                        <TextBlock Margin="16,0,0,0" FontWeight="Bold" Text="{Binding ConnectionStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="CONNECTED">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Foreground="DarkRed"
                               Visibility="{Binding ConfigurationErrorVisibility}"
                               Text="{Binding ConfigurationErrorMessage}"/>
                </StackPanel>
            </Border>

            <GroupBox Grid.Row="1" Header="Game" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Player Name:" FontWeight="SemiBold"/>
                        <TextBox Margin="0,6,0,6" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Player Email:" FontWeight="SemiBold"/>
                        <TextBox Margin="0,6,0,12" Text="{Binding PlayerEmail, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Height="32" Width="160" Content="Start Game"
                                Command="{Binding StartGameCommand}"/>

                        <Separator Margin="0,12,0,12"/>

                        <TextBlock Text="Puzzle String:" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,12"
                                   FontFamily="Consolas"
                                   FontSize="20"
                                   TextWrapping="Wrap"
                                   Text="{Binding PuzzleString}"/>

                        <TextBlock Text="Guess Word:" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox x:Name="GuessWordTextBox" Width="260"
                                     Text="{Binding GuessWord, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="GuessWordTextBox_KeyDown"/>
                            <Button Width="140" Margin="10,0,0,0" Content="Submit Guess"
                                    Command="{Binding SubmitGuessCommand}"/>
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding FeedbackMessage}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="High Score:" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,12" FontSize="18" Foreground="DarkGoldenrod"
                                   Text="{Binding HighScore}"/>

                        <TextBlock Text="Current Score:" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,12" FontSize="18" Foreground="DarkBlue"
                                   Text="{Binding CurrentScore}"/>

                        <TextBlock Text="Time Left (sec):" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,12" FontSize="18" Text="{Binding TimeLeftSeconds}"/>

                        <TextBlock Text="# Of Words Left:" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,12" FontSize="18" Text="{Binding WordsLeft}"/>

                        <TextBlock Text="# Of Wrong Tries:" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <TextBlock FontSize="18" Text="{Binding TriesUsed}"/>
                            <TextBlock FontSize="18" Text=" / "/>
                            <TextBlock FontSize="18" Text="{Binding MaxTries}"/>
                        </StackPanel>

                        <Separator Margin="0,12,0,12"/>

                        <TextBlock Text="Found Words:" FontWeight="SemiBold"/>
                        <ListBox Height="180" ItemsSource="{Binding FoundWords}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Client Log" Padding="12" Margin="0,12,0,0">
                <ListBox ItemsSource="{Binding LogMessages}" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>